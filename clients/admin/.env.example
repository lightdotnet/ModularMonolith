# Backend API base URLs (server-only — never expose via NEXT_PUBLIC_).
# Each must include its full path prefix (e.g. api/v1) and a trailing slash —
# request paths are resolved against these as-is, with nothing prepended.
# The backend's HTTPS dev endpoint (Kestrel default: https://localhost:5001).
# `pnpm dev`/`pnpm start` run Node with --use-system-ca so `fetch` trusts the
# ASP.NET Core dev certificate from the OS store.
IDENTITY_API_BASE_URL=https://localhost:5001/api/v1/
NOTIFICATIONS_API_BASE_URL=https://localhost:5001/api/v1/
ORGANIZATION_API_BASE_URL=https://localhost:5001/api/v1/
APPROVAL_API_BASE_URL=https://localhost:5001/api/v1/
LEAVE_MANAGEMENT_API_BASE_URL=https://localhost:5001/api/v1/

# SignalR notification hub — the browser connects directly to the backend
# (bypasses the Next.js server), so this must be an absolute URL. Requires the
# backend to allow CORS for this app's origin.
#
# Read server-side and handed to the browser at runtime by a Server Action
# (NOT NEXT_PUBLIC_-inlined), so it is a runtime setting: change it by editing
# the deployed server's .env and restarting the service — no rebuild.
SIGNALR_HUB_URL=https://localhost:5001/signalr-hub


# 32-byte key, base64-encoded, used to encrypt session token data at rest in cookies.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=9v1IgHcNz4Vd6/+wNaQJjTQRZUAG1FfAiXXCG/774YA=

# Base64-encoded AES key (16/24/32 bytes decoded) that Next.js uses as the salt
# for Server Action IDs and to encrypt Server Action closure variables.
# Generate one with: openssl rand -base64 32
#
# MUST be present at BUILD time and stay CONSTANT forever. If unset, Next.js
# generates a fresh random key on every `next build` (the deploy scripts wipe
# .next each deploy, so the 14-day key cache never survives) — every deploy then
# rotates all Server Action IDs, and any browser tab still running the previous
# build fails with "Failed to find Server Action" until it is reloaded.
# On deployed servers this lives in the preserved standalone/.env, and
# clients/deploy-nssm.ps1 hoists it into the build environment (see that script,
# Get-ServerActionsEncryptionKey / Step 2). Changing the value reproduces the
# same one-time breakage, so treat it as fixed.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=MwSjHJJCdPbRBXsSTO3ijAtG1W2bInTTB4iEz5jdw4g=