<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>ModularMonolith.Solution.Template</id>
    <title>ASP.NET Core Modular Monolith Solution Template</title>
    <version>2.1.0</version>
    <authors>minhvu</authors>
    <description>
      StarterKit modular monolith template pack for ASP.NET Core on .NET 10. Contains the
      solution template (short name mm-sln: framework building blocks, host, Identity and
      Notifications modules, migrators, tests, and the Next.js admin client) plus two module
      templates for adding new modules: mm (single implementation project plus Contracts) and
      ca-mm (Clean Architecture split into Domain, Application, Infrastructure and Contracts).
    </description>
    <language>en-US</language>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/minhvd/ModularMonolith</projectUrl>
    <releaseNotes>
      * Solution template mm-sln: framework, host, Identity and Notifications modules, Next.js admin client
      * Module templates: mm (single project + Contracts) and ca-mm (Domain/Application/Infrastructure + Contracts)
      * Module templates now follow the real module layout: StarterKit.Modules.ModuleName namespaces, AppModule/AppModuleConsumer scaffolding, AddModuleNameServices registration
      * Fixed the corrupted ca-mm Domain project file
    </releaseNotes>
    <packageTypes>
      <packageType name="Template" />
    </packageTypes>
    <tags>StarterKit Modular Monolith Architecture ddd domain-driven-design modular-monolith-architecture modular monolith architecture minhvu SOLID aspnetcore</tags>
    <icon>icon.png</icon>
    <readme>README.md</readme>
  </metadata>
  <files>
    <file src="README.md" />
    <file src=".template.config\icon.png" />
    <file src=".\**" target="content" exclude="**\bin\**;**\obj\**;**\.git\**;**\.github\**;**\.claude\**;**\*.user;**\.vs\**;**\.vscode\**;**\.gitignore;**\sample\**;**\logs\**;**\node_modules\**;**\TestResults\**;**\.next\**;**\coverage\**;**\dist\**;**\*.nupkg;**\*.snupkg;" />
  </files>
</package>
