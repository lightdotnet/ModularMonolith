{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-recap.js",
            "timeout": 15,
            "statusMessage": "Re-grounding context after resume/compaction..."
          }
        ]
      }
    ]
  }
}
