<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StarterKit Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @* Inlined instead of a wwwroot file: the same markup is served by the standalone host and the
       co-host, where a static web asset would need a different URL (_content/...) per host. *@
    <style>
        .admin-sidebar .nav-link { color: var(--bs-body-color); }
        .admin-sidebar .nav-link.active { color: #fff; }

        @@media (min-width: 768px) {
            .admin-sidebar { min-height: calc(100vh - 56px); }
        }

        /* Tables marked .table-stack turn into stacked cards on small screens; each cell shows
           its column name from data-label. */
        @@media (max-width: 767.98px) {
            .table-stack thead { display: none; }
            .table-stack, .table-stack tbody, .table-stack tr, .table-stack td { display: block; width: 100%; }
            .table-stack tr {
                border: 1px solid var(--bs-border-color);
                border-radius: var(--bs-border-radius);
                background: var(--bs-body-bg);
                margin-bottom: .75rem;
                padding: .5rem .75rem;
            }
            .table-stack td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
                border: 0;
                padding: .25rem 0;
                text-align: end;
                min-height: 2rem;
            }
            .table-stack td[data-label]:not([data-label=""])::before {
                content: attr(data-label);
                font-weight: 600;
                text-align: start;
                color: var(--bs-secondary-color);
            }
            .table-stack td.table-stack-actions { justify-content: flex-end; }
        }

        .table-matrix th:first-child, .table-matrix td:first-child {
            position: sticky;
            left: 0;
            z-index: 1;
            background: var(--bs-body-bg);
        }
    </style>
</head>
<body class="bg-light">
    <header class="navbar navbar-dark bg-primary sticky-top">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                <button class="navbar-toggler d-md-none me-2"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#adminSidebar"
                        aria-controls="adminSidebar"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand" asp-page="/Admin/Index">StarterKit Admin</a>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-light btn-sm" asp-page="/Index" title="Home" aria-label="Home">
                    <i class="bi bi-house" aria-hidden="true"></i>
                </a>
                <form method="post" asp-page="/Account/Logout" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm" title="Sign out" aria-label="Sign out">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>
            </div>
        </div>
    </header>
    <div class="container-fluid">
        <div class="row">
            <aside class="col-md-3 col-xl-2 p-0 bg-body border-end admin-sidebar">
                <div class="offcanvas-md offcanvas-start" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
                    <div class="offcanvas-header">
                        <h2 class="offcanvas-title h5" id="adminSidebarLabel">Administration</h2>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="offcanvas"
                                data-bs-target="#adminSidebar"
                                aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body p-3">
                        <partial name="_AdminNav" />
                    </div>
                </div>
            </aside>
            <main class="col-md-9 col-xl-10 py-4 px-3 px-md-4">
                <flash-messages />
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_AdminConfirmModal" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
