@page
@model StarterKit.Identity.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Sign in</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="alert alert-danger" role="alert">@Model.Error</div>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <form method="post" asp-page-handler="Password">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Username</label>
                        <input asp-for="UserName" class="form-control" autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>

                @if (Model.MicrosoftLoginEnabled)
                {
                    <div class="text-center my-3">or</div>
                    <form method="post" asp-page-handler="Microsoft">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <button type="submit" class="btn btn-outline-primary w-100">
                            Continue with Microsoft work or school account
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
