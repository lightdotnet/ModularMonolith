@page "{id}"
@model StarterKit.Modules.Identity.Web.Pages.Admin.Roles.EditModel
@{
    ViewData["Title"] = $"Edit role {Model.Role.Name}";
    var selected = Model.Input.Permissions.ToHashSet(StringComparer.Ordinal);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Admin/Roles/Index">Roles</a></li>
        <li class="breadcrumb-item active text-break" aria-current="page">@Model.Role.Name</li>
    </ol>
</nav>

<h1 class="h3 mb-3 text-break">@Model.Role.Name</h1>

<form method="post" asp-route-id="@Model.Role.Id">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-12 col-xl-4">
            <div class="card shadow-sm">
                <div class="card-header">Details</div>
                <div class="card-body">
                    <form-field asp-for="Input.Name" autocomplete="off" />
                    <form-field asp-for="Input.Description" />
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-8">
            <div class="card shadow-sm">
                <div class="card-header">Permissions</div>
                <div class="card-body">
                    @if (Model.Groups.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">No permissions are defined.</p>
                    }
                    else if (!Model.IsFullControl)
                    {
                        <p class="form-text mt-0">You can only grant or revoke permissions you hold.</p>
                    }
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var group in Model.Groups)
                        {
                            var groupKey = $"group-{group.Name}";
                            <div class="col">
                                <fieldset class="border rounded p-3 h-100">
                                    <legend class="float-none w-auto px-2 fs-6 mb-0">
                                        <span class="form-check mb-0">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="@groupKey"
                                                   data-check-all="@groupKey" />
                                            <label class="form-check-label fw-semibold text-capitalize" for="@groupKey">@group.Name</label>
                                        </span>
                                    </legend>
                                    @foreach (var permission in group.Permissions)
                                    {
                                        var inputId = $"perm-{permission.Name}";
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="@inputId"
                                                   name="Input.Permissions"
                                                   value="@permission.Name"
                                                   data-check-group="@groupKey"
                                                   checked="@selected.Contains(permission.Name)"
                                                   disabled="@(!Model.CanGrant(permission.Name))" />
                                            <label class="form-check-label" for="@inputId">
                                                @permission.DisplayName
                                                <span class="d-block small text-body-secondary text-break">@permission.Name</span>
                                            </label>
                                        </div>
                                    }
                                </fieldset>
                            </div>
                        }
                    </div>

                    @if (Model.OtherPermissions.Count > 0)
                    {
                        <div class="mt-3 small text-body-secondary">
                            Also granted (defined by a module not loaded here, kept unchanged):
                            <span class="text-break">@string.Join(", ", Model.OtherPermissions)</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-3">
        <a class="btn btn-outline-secondary" asp-page="/Admin/Roles/Index">Back</a>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>
