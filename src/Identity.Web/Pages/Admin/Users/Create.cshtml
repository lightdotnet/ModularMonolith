@page
@model StarterKit.Modules.Identity.Web.Pages.Admin.Users.CreateModel
@{
    ViewData["Title"] = "New user";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Admin/Users/Index">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">New user</li>
    </ol>
</nav>

<h1 class="h3 mb-3">New user</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row">
                <form-field asp-for="Input.UserName" class="col-12 col-md-6" autocomplete="off" />
                <form-field asp-for="Input.AuthProvider" class="col-12 col-md-6" asp-items="Model.AuthProviders" />
                <form-field asp-for="Input.FirstName" class="col-12 col-md-6" />
                <form-field asp-for="Input.LastName" class="col-12 col-md-6" />
                <form-field asp-for="Input.Email" class="col-12 col-md-6" />
                <form-field asp-for="Input.PhoneNumber" class="col-12 col-md-6" />
                <form-field asp-for="Input.Password"
                            class="col-12 col-md-6"
                            autocomplete="new-password"
                            hint="Leave empty for accounts that sign in with Active Directory or Microsoft." />
            </div>
            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                <a class="btn btn-outline-secondary" asp-page="/Admin/Users/Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Create user</button>
            </div>
        </form>
    </div>
</div>
