{
  "Environment": "UAT",
  "DbProvider": "MSSQL", // InMemory|PostgreSQL|MSSQL|Sqlite
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SeedDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
    //"DefaultConnection": "Host=(localdb);Port=5432;Database=SeedDb;Username=admin;Password=P@ssword",
    //"DefaultConnection": "Data Source=D:\\Files\\Sqlite\\Seed.Db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Hangfire": "Warning",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Hangfire": "Warning",
        "Microsoft": "Error",
        "System": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "FileAsync"
      }
    ]
  },
  "RequestLogging": {
    "Enable": true,
    "IncludeRequest": false,
    "IncludeResponse": false,
    "ExcludePaths": [ "/hc", "signalr-hub", "auth/token/hub" ]
  },
  "AllowAnonymous": false,
  "Swagger": {
    "Enable": true,
    "Title": "Starter API",
    "SecurityScheme": "jwt|basic",
    "VersionDefinition": true
  },
  "BasicAuth": "super:123",
  "Jwt": {
    "Issuer": "https://localhost",
    "SecretKey": "2f857c1b9b2ea28e67986c5aa7a1955ac0ae3cf74400b22cc18fe25ea8e660b1",
    "AccessTokenExpirationSeconds": 7200,
    "RefreshTokenExpirationDays": 7
  },
  "CorsOrigins": [
    "http://localhost:3000" // NextJS
  ],
