@model IReadOnlyList<NotificationDto>?
@if (Model is null)
{
    <div class="text-center text-body-secondary small py-4 px-3">Notifications could not be loaded.</div>
}
else if (Model.Count == 0)
{
    <empty-state icon="bell" title="No notifications" description="You're all caught up." />
}
else
{
    <div class="list-group list-group-flush">
        @foreach (var notification in Model)
        {
            var isUnread = notification.Status == NotificationStatus.None;
            <a class="list-group-item list-group-item-action py-2 @(isUnread ? "dt-row-unread" : null)"
               asp-controller="MyNotifications"
               asp-action="Detail"
               asp-route-id="@notification.Id">
                <div class="d-flex align-items-center gap-2">
                    @if (isUnread)
                    {
                        <span class="unread-dot flex-shrink-0" aria-hidden="true"></span>
                        <span class="visually-hidden">Unread:</span>
                    }
                    <span class="small text-truncate">@notification.Title</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(notification.Message))
                {
                    <div class="small text-body-secondary text-truncate">@notification.Message</div>
                }
                <div class="small text-body-secondary"><local-datetime value="@notification.Created" format="relative" /></div>
            </a>
        }
    </div>
}
