@{
    var displayName = User.GetDisplayName();
    var userName = User.GetUserName();
}
<div class="dropdown">
    <button class="btn btn-link text-body text-decoration-none dropdown-toggle d-flex align-items-center gap-2 px-1"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="User menu">
        <i class="bi bi-person-circle fs-5" aria-hidden="true"></i>
        <span class="d-none d-sm-inline text-truncate app-user-name">@displayName</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
        <li class="px-3 py-2">
            <div class="fw-semibold text-truncate">@displayName</div>
            <div class="small text-body-secondary text-truncate">@userName</div>
        </li>
        <li><hr class="dropdown-divider" /></li>
        <li>
            <form method="post" asp-page="/Account/Logout" class="m-0">
                <button type="submit" class="dropdown-item">
                    <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out
                </button>
            </form>
        </li>
    </ul>
</div>
