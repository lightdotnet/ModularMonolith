@page "/identity/users/{id}/password"
@model StarterKit.WebMvc.Pages.Identity.Users.PasswordModel
@using StarterKit.WebMvc.Pages.Identity

<page-header title="Force password" subtitle="@Model.UserName">
    <breadcrumb-item href="@Url.Content("~/")">Home</breadcrumb-item>
    <breadcrumb-item href="@Url.Page("Index")">Users</breadcrumb-item>
    <breadcrumb-item>Force password</breadcrumb-item>
</page-header>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        @if (!IdentityOptions.RequiresPassword(Model.AuthProvider))
        {
            <div class="alert alert-warning small" role="alert">
                This account signs in through its directory (@Model.AuthProvider); a password set here is not used for that sign-in.
            </div>
        }
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" data-loading-form novalidate>
                    <partial name="_ValidationSummary" />
                    <fieldset>
                        <form-field asp-for="Input.NewPassword" autocomplete="new-password" autofocus="true" />
                        <form-field asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <submit-button icon="key">Set password</submit-button>
                            <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
</div>
