@page "/identity/roles/{id}/edit"
@model StarterKit.WebMvc.Pages.Identity.Roles.EditModel

<page-header title="Edit role" subtitle="@Model.Input.Name">
    <breadcrumb-item href="@Url.Content("~/")">Home</breadcrumb-item>
    <breadcrumb-item href="@Url.Page("Index")">Roles</breadcrumb-item>
    <breadcrumb-item>Edit</breadcrumb-item>
</page-header>

<form method="post" data-loading-form novalidate>
    <partial name="_ValidationSummary" />
    <input type="hidden" asp-for="Input.Id" />
    @for (var i = 0; i < Model.OtherClaims.Count; i++)
    {
        <input type="hidden" asp-for="OtherClaims[i].Type" />
        <input type="hidden" asp-for="OtherClaims[i].Value" />
    }

    <fieldset class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 mb-3">Details</h2>
                    <form-field asp-for="Input.Name" label="Name" autocomplete="off" />
                    <form-field asp-for="Input.Description" label="Description" type="textarea" rows="3" />

                    @if (Model.OtherClaims.Count > 0)
                    {
                        <h2 class="h6 mt-2 mb-2">Other claims</h2>
                        <p class="small text-body-secondary">Kept unchanged when saving.</p>
                        <ul class="list-unstyled small mb-0">
                            @foreach (var claim in Model.OtherClaims)
                            {
                                <li class="text-break"><span class="text-body-secondary">@claim.Type:</span> @claim.Value</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 mb-3">Permissions</h2>
                    @if (Model.PermissionCatalogUnavailable)
                    {
                        @* Catalog failed to load: keep the posted selection so nothing is dropped, and block saving. *@
                        @foreach (var permission in Model.SelectedPermissions)
                        {
                            <input type="hidden" name="SelectedPermissions" value="@permission" />
                        }
                        <div class="alert alert-warning small mb-0" role="alert">
                            The permission list could not be loaded, so permissions cannot be shown or changed right now.
                            Saving is disabled to avoid removing this role's permissions — reload the page to try again.
                        </div>
                    }
                    else if (Model.PermissionGroups.Count == 0)
                    {
                        <p class="small text-body-secondary mb-0">No permissions available.</p>
                    }
                    else
                    {
                        <div class="row g-3">
                            @for (var g = 0; g < Model.PermissionGroups.Count; g++)
                            {
                                var group = Model.PermissionGroups[g];
                                <div class="col-12 col-md-6">
                                    <fieldset class="border rounded p-3 h-100">
                                        <legend class="float-none w-auto fs-6 fw-semibold text-capitalize px-1 mb-0">@group.Name</legend>
                                        @for (var p = 0; p < group.Permissions.Count; p++)
                                        {
                                            var permission = group.Permissions[p];
                                            var checkId = $"perm-{g}-{p}";
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="SelectedPermissions"
                                                       id="@checkId"
                                                       value="@permission.Name"
                                                       checked="@Model.SelectedPermissions.Contains(permission.Name)" />
                                                <label class="form-check-label" for="@checkId">
                                                    @permission.DisplayName
                                                    <span class="d-block small text-body-secondary text-break">@permission.Name</span>
                                                </label>
                                            </div>
                                        }
                                    </fieldset>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row gap-2">
                <submit-button icon="check-lg" disabled="@Model.PermissionCatalogUnavailable">Save changes</submit-button>
                <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
            </div>
        </div>
    </fieldset>
</form>
