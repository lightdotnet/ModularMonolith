{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // StarterKit.WebApi's plain-http dev endpoint (see its launchSettings.json) — avoids the
  // self-signed dev-certificate problem for server-to-server calls, as the admin client does.
  "Api": {
    "Identity": {
      "BaseUrl": "http://localhost:5000/api/v1/"
    },
    "Notifications": {
      "BaseUrl": "http://localhost:5000/api/v1/"
    }
  },
  // Identity.Web is co-hosted inside StarterKit.WebApi.
  "IdentityWeb": {
    "BaseUrl": "http://localhost:5000"
  },
  "SignalR": {
    "HubUrl": "http://localhost:5000/signalr-hub"
  },
  "Authorization": {
    "SuperAdminUserNames": [ "super" ]
  }
}
